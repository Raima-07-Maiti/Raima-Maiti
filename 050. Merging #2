#include <stdio.h>

int main()
{
    unsigned n, m, i=0, j=0, k=0;
    printf("\nEnter the length of first array: ");
    scanf("%u", &n);
    printf("\nEnter the length of second array: ");
    scanf("%u", &m);
    int arr1[n], arr2[m], merged[n+m];
    printf("\nEnter the elements of the first array: ");
    for(int i=0; i<n; i++)
    {
        scanf("%d", &arr1[i]);
    }
    printf("\nEnter the elements of the second array: ");
    for(int i=0; i<m; i++)
    {
        scanf("%d", &arr2[i]);
    }
    while(i<n && j<m)
    {
        if(arr1[i]< arr2[j])
        {
            merged[k++]=arr1[i++];
        }
        else if(arr1[i]>arr2[j])
        {
            merged[k++]=arr2[j++];
        }
    }
    if(i==n)
    {
        for(int p=j; p<m; p++)
        {
            merged[k++]=arr2[p];
        }
    }
    else
    {
       for(int p=i; p<n; p++)
        {
            merged[k++]=arr2[p];
        } 
    }
    
    printf("\nThe merged array is thus:\n" );
    for(int a=0; a<k; a++)
    {
        printf("merged[%d]= %d\n", a, merged[a]);
    }

    return 0;
}
