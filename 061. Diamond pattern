#include <stdio.h>

int main()
{
    int n; 
    printf("Enter a number: ");
    scanf("%d", &n);
    for(int i=1; i<=n; i+=2)
    {
        for(int s=n; s>i; s-=2)
        {
            printf(" ");
        }
        for(int j=i; j>0;j--)
        {
            printf("*");
        }
        printf("\n");
    }
    for(int i=n-2; i>0; i-=2)
    {
        for(int s=i; s<=n-2; s+=2)
        {
            printf(" ");
        }
        for(int j=1; j<=i;j++)
        {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
